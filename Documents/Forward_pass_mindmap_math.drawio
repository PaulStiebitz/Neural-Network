        <mxCell id="uP7TciB98O3cOZ6XCzb7-527" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;div style=&quot;font-family:&#39;Segoe UI&#39;;font-size:14px;font-style:normal;font-weight:400;line-height:20px&quot;&gt;\(&#xa;\begin{gathered}&#xa;\text{Hidden Layer 2:}\\[-1pt]&#xa;\longrightarrow\quad&#xa;z^{[2]}_{\mathbb{R}^{64\times1}}&#xa;\quad\xrightarrow{\mathrm{ReLU}}\quad&#xa;a^{[2]}_{\mathbb{R}^{64\times1}}&#xa;\end{gathered}&#xa;\)&lt;/div&gt;" vertex="1">
          <mxGeometry height="70" width="230" x="51" y="1241" as="geometry" />
        </mxCell>
        <mxCell id="uP7TciB98O3cOZ6XCzb7-528" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;div style=&quot;font-family:&#39;Segoe UI&#39;;font-size:14px;font-style:normal;font-weight:400;line-height:20px&quot;&gt;\(&#xa;\begin{gathered}&#xa;\text{Hidden Layer 1:}\\[-2pt]&#xa;\longrightarrow\quad&#xa;\underset{\mathbb{R}^{128\times1}}{z^{[1]}}&#xa;\quad\xrightarrow{\mathrm{ReLU}}\quad&#xa;\underset{\mathbb{R}^{128\times1}}{a^{[1]}}&#xa;\end{gathered}&#xa;\)&lt;/div&gt;" vertex="1">
          <mxGeometry height="70" width="220" x="-178" y="1241" as="geometry" />
        </mxCell>
        <mxCell id="uP7TciB98O3cOZ6XCzb7-529" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;div style=&quot;text-align: start; font-family: &amp;quot;Segoe UI&amp;quot;; font-size: 14px; line-height: 20px;&quot;&gt;&lt;div style=&quot;line-height: 20px;&quot;&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;\(a^{[0]}\in\mathbb{R}^{784\times1}\)&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="30" width="60" x="-259" y="1268" as="geometry" />
        </mxCell>
        <mxCell id="uP7TciB98O3cOZ6XCzb7-530" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="Input" vertex="1">
          <mxGeometry height="30" width="60" x="-272" y="1238" as="geometry" />
        </mxCell>
        <mxCell id="uP7TciB98O3cOZ6XCzb7-531" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;div style=&quot;font-family:&#39;Segoe UI&#39;;font-size:14px;font-style:normal;font-weight:400;line-height:20px&quot;&gt;\(&#xa;\begin{gathered}&#xa;\text{Output Layer:}\\[-1pt]&#xa;\longrightarrow\quad&#xa;\underset{\mathbb{R}^{10\times1}}{z^{[3]}}&#xa;\quad\xrightarrow{\mathrm{softmax}}\quad&#xa;\underset{\mathbb{R}^{10\times1}}{\hat{\mathbf y}}&#xa;\end{gathered}&#xa;\)&lt;/div&gt;" vertex="1">
          <mxGeometry height="140" width="50" x="290" y="1242" as="geometry" />
        </mxCell>
        <mxCell id="uP7TciB98O3cOZ6XCzb7-532" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;div style=&quot;font-family:&#39;Segoe UI&#39;;font-size:14px;font-style:normal;font-weight:400;line-height:20px&quot;&gt;\(&#xa;\begin{aligned}&#xa;&amp;amp;\textbf{Activation and Loss Derivatives}&#xa;\\[6pt]&#xa;&amp;amp;\operatorname{ReLU}&#39;(z)&#xa;=&#xa;\begin{cases}&#xa;1, &amp;amp; z&amp;gt;0,\\&#xa;0, &amp;amp; z\le 0,&#xa;\end{cases}&#xa;\\[10pt]&#xa;&amp;amp;J(\mathbf y,\hat{\mathbf y})&#xa;=&#xa;-\sum_{i=1}^{10}&#xa;y_i \log(\hat y_i)&#xa;\qquad&#xa;\text{(Cross-Entropy Loss)}&#xa;\\[10pt]&#xa;&amp;amp;\text{For Softmax output and Cross-Entropy loss:}&#xa;\\[6pt]&#xa;&amp;amp;\boxed{&#xa;\delta^{[3]}&#xa;=&#xa;\frac{\partial J}{\partial z^{[3]}}&#xa;=&#xa;\hat{\mathbf y}&#xa;-&#xa;\mathbf y&#xa;}&#xa;\end{aligned}&#xa;\)&lt;/div&gt;" vertex="1">
          <mxGeometry height="250" width="380" x="-351" y="978" as="geometry" />
        </mxCell>
        <mxCell id="uP7TciB98O3cOZ6XCzb7-533" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;div style=&quot;font-family:&#39;Segoe UI&#39;;font-size:14px;font-style:normal;font-weight:400;line-height:20px&quot;&gt;&lt;div style=&quot;line-height: 20px;&quot;&gt;&lt;div style=&quot;line-height: 20px;&quot;&gt;\( \begin{aligned} &amp;amp;\textbf{Gradient Descent} \\[6pt] &amp;amp;\frac{\partial J}{\partial W^{[l]}} = \delta^{[l]}(a^{[l-1]})^T \\[8pt] &amp;amp;\frac{\partial J}{\partial b^{[l]}} = \delta^{[l]} \\[10pt] &amp;amp;W^{[l]} \leftarrow W^{[l]} -\eta\frac{\partial J}{\partial W^{[l]}} \\[8pt] &amp;amp;b^{[l]} \leftarrow b^{[l]} -\eta\frac{\partial J}{\partial b^{[l]}} \end{aligned} \)&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="140" width="190" x="-763.5" y="1528" as="geometry" />
        </mxCell>
        <mxCell id="uP7TciB98O3cOZ6XCzb7-534" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;div style=&quot;font-family:&#39;Segoe UI&#39;;font-size:14px;font-style:normal;font-weight:400;line-height:20px&quot;&gt;&lt;div style=&quot;line-height: 20px;&quot;&gt;\( \begin{aligned} &amp;amp;\textbf{Hidden Layer 1} \\[6pt] &amp;amp;a^{[1]} = \operatorname{ReLU}(z^{[1]}) \\[8pt] &amp;amp;\operatorname{ReLU}&#39;(z) = \begin{cases} 1,&amp;amp;z&amp;gt;0\\ 0,&amp;amp;z\le0 \end{cases} \\[10pt] &amp;amp;\delta^{[1]} = ((W^{[2]})^T\delta^{[2]}) \odot \operatorname{ReLU}&#39;(z^{[1]}) \end{aligned} \)&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="190" width="270" x="-327.5" y="1528" as="geometry" />
        </mxCell>
        <mxCell id="uP7TciB98O3cOZ6XCzb7-535" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;div style=&quot;font-family:&#39;Segoe UI&#39;;font-size:14px;font-style:normal;font-weight:400;line-height:20px&quot;&gt;&lt;div style=&quot;line-height: 20px;&quot;&gt;\( \begin{aligned} &amp;amp;\textbf{Hidden Layer 2} \\[6pt] &amp;amp;a^{[2]} = \operatorname{ReLU}(z^{[2]}) \\[8pt] &amp;amp;\operatorname{ReLU}&#39;(z) = \begin{cases} 1,&amp;amp;z&amp;gt;0\\ 0,&amp;amp;z\le0 \end{cases} \\[10pt] &amp;amp;\delta^{[2]} = ((W^{[3]})^T\delta^{[3]}) \odot \operatorname{ReLU}&#39;(z^{[2]}) \end{aligned} \)&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="190" width="270" x="113" y="1528" as="geometry" />
        </mxCell>
        <mxCell id="uP7TciB98O3cOZ6XCzb7-536" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;div style=&quot;font-family:&#39;Segoe UI&#39;;font-size:14px;font-style:normal;font-weight:400;line-height:20px&quot;&gt;&lt;div style=&quot;line-height: 20px;&quot;&gt;\( \begin{aligned} &amp;amp;\textbf{Output Layer} \\[6pt] &amp;amp;\hat{\mathbf y} = \operatorname{Softmax}(z^{[3]}) \\[8pt] &amp;amp;J(\mathbf y,\hat{\mathbf y}) = -\sum_{i=1}^{10} y_i\log(\hat y_i) \\[8pt] &amp;amp;\delta^{[3]} = \frac{\partial J}{\partial z^{[3]}} = \hat{\mathbf y}-\mathbf y \end{aligned} \)&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="180" width="160" x="531.5" y="1533" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
