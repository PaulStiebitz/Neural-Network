        <mxCell id="DzZVFQiHHRxu_J_QxA1l-150" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;div style=&quot;font-family:&#39;Segoe UI&#39;;font-size:14px;font-style:normal;font-weight:400;line-height:20px&quot;&gt;\(\hat{c}\in\{0,\ldots,9\}\)&lt;/div&gt;" vertex="1">
          <mxGeometry height="40" width="110" x="698" y="468" as="geometry" />
        </mxCell>
        <mxCell id="DzZVFQiHHRxu_J_QxA1l-157" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;b style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 30px;&quot; face=&quot;Mathjax&quot;&gt;Forward-pass&lt;/font&gt;&lt;/b&gt;" vertex="1">
          <mxGeometry height="30" width="220" x="-844" y="60" as="geometry" />
        </mxCell>
        <mxCell id="DzZVFQiHHRxu_J_QxA1l-179" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;div style=&quot;font-family:&#39;Segoe UI&#39;;font-size:14px;font-style:normal;font-weight:400;line-height:20px&quot;&gt;\(\textbf{Neural Network Notation}\)&#xa;&#xa;\(&#xa;\begin{aligned}&#xa;a^{[l-1]} &amp;amp;: \text{Input of layer } l \\&#xa;z^{[l]} &amp;amp;: \text{Linear pre-activation} \\&#xa;a^{[l]} &amp;amp;: \text{Output after activation} \\&#xa;W^{[l]} &amp;amp;: \text{Weight matrix} \\&#xa;b^{[l]} &amp;amp;: \text{Bias vector} \\&#xa;f^{[l]}(\cdot) &amp;amp;: \text{Activation function} \\&#xa;\\&#xa;z^{[l]} &amp;amp;= W^{[l]}a^{[l-1]}+b^{[l]} \\&#xa;a^{[l]} &amp;amp;= f^{[l]}(z^{[l]})&#xa;\end{aligned}&#xa;\)&lt;/div&gt;" vertex="1">
          <mxGeometry height="270" width="240" x="-365" y="60" as="geometry" />
        </mxCell>
        <mxCell id="DzZVFQiHHRxu_J_QxA1l-180" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;div style=&quot;font-family:&#39;Segoe UI&#39;;font-size:14px;font-style:normal;font-weight:400;line-height:20px&quot;&gt;\(\textbf{Activation and Classification Functions}\)&#xa;&#xa;\(&#xa;\begin{aligned}&#xa;f^{[l]}(z)&#xa;&amp;amp;=&#xa;\operatorname{ReLU}(z)&#xa;=&#xa;\begin{cases}&#xa;z, &amp;amp; z&amp;gt;0\\&#xa;0, &amp;amp; z\le0&#xa;\end{cases}&#xa;\\[6pt]&#xa;\operatorname{Softmax}(z)_i&#xa;&amp;amp;=&#xa;\frac{\exp(z_i)}&#xa;{\sum_{j=1}^{n}\exp(z_j)},&#xa;\quad i\in\{1,\ldots,n\}&#xa;\\[6pt]&#xa;\operatorname{argmax}(x)&#xa;&amp;amp;=&#xa;\left\{&#xa;i\in\{1,\ldots,n\}&#xa;\mid&#xa;x_i=\max_{1\le j\le n}x_j&#xa;\right\}&#xa;\end{aligned}&#xa;\)&lt;/div&gt;" vertex="1">
          <mxGeometry height="210" width="350" x="-80" y="60" as="geometry" />
        </mxCell>
        <mxCell id="DzZVFQiHHRxu_J_QxA1l-185" parent="1" style="text;whiteSpace=wrap;html=1;strokeColor=light-dark(transparent,#FF0000);fillColor=light-dark(transparent,#FF0000);" value="&lt;div style=&quot;font-size: 14px; font-style: normal; font-weight: 400; line-height: 20px;&quot;&gt;&lt;div style=&quot;white-space: normal; line-height: 20px;&quot;&gt;&lt;font face=&quot;Mathjax&quot;&gt;Input Layer: \(a^{[0]} \to a^{[1]}\) \[ \underbrace{ \begin{bmatrix} w^{[1]}_{11}&amp;amp;w^{[1]}_{12}&amp;amp;\cdots&amp;amp;w^{[1]}_{1,784}\\ w^{[1]}_{21}&amp;amp;w^{[1]}_{22}&amp;amp;\cdots&amp;amp;w^{[1]}_{2,784}\\ \vdots&amp;amp;\vdots&amp;amp;\ddots&amp;amp;\vdots\\ w^{[1]}_{128,1}&amp;amp;w^{[1]}_{128,2}&amp;amp;\cdots&amp;amp;w^{[1]}_{128,784} \end{bmatrix} }_{W^{[1]}} \begin{bmatrix} a^{[0]}_1\\ a^{[0]}_2\\ \vdots\\ a^{[0]}_{784} \end{bmatrix} + \underbrace{ \begin{bmatrix} b^{[1]}_1\\ b^{[1]}_2\\ \vdots\\ b^{[1]}_{128} \end{bmatrix} }_{b^{[1]}} = \begin{bmatrix} z^{[1]}_1\\ z^{[1]}_2\\ \vdots\\ z^{[1]}_{128} \end{bmatrix} \] \[ \operatorname{ReLU} \left( \begin{bmatrix} z^{[1]}_1\\ z^{[1]}_2\\ \vdots\\ z^{[1]}_{128} \end{bmatrix} \right) = \begin{bmatrix} a^{[1]}_1\\ a^{[1]}_2\\ \vdots\\ a^{[1]}_{128} \end{bmatrix} \]&lt;/font&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="310" width="400" x="-816" y="600" as="geometry" />
        </mxCell>
        <mxCell id="DzZVFQiHHRxu_J_QxA1l-188" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;div style=&quot;font-size: 14px; font-style: normal; font-weight: 400; line-height: 20px;&quot;&gt;&lt;div style=&quot;white-space: normal; line-height: 20px;&quot;&gt;&lt;font face=&quot;Mathjax&quot;&gt;Hidden Layer 1: \(a^{[1]} \to a^{[2]}\) \[ \underbrace{ \begin{bmatrix} w^{[2]}_{11}&amp;amp;w^{[2]}_{12}&amp;amp;\cdots&amp;amp;w^{[2]}_{1,128}\\ w^{[2]}_{21}&amp;amp;w^{[2]}_{22}&amp;amp;\cdots&amp;amp;w^{[2]}_{2,128}\\ \vdots&amp;amp;\vdots&amp;amp;\ddots&amp;amp;\vdots\\ w^{[2]}_{64,1}&amp;amp;w^{[2]}_{64,2}&amp;amp;\cdots&amp;amp;w^{[2]}_{64,128} \end{bmatrix} }_{W^{[2]}} \begin{bmatrix} a^{[1]}_1\\ a^{[1]}_2\\ \vdots\\ a^{[1]}_{128} \end{bmatrix} + \underbrace{ \begin{bmatrix} b^{[2]}_1\\ b^{[2]}_2\\ \vdots\\ b^{[2]}_{64} \end{bmatrix} }_{b^{[2]}} = \begin{bmatrix} z^{[2]}_1\\ z^{[2]}_2\\ \vdots\\ z^{[2]}_{64} \end{bmatrix} \] \[ \operatorname{ReLU} \left( \begin{bmatrix} z^{[2]}_1\\ z^{[2]}_2\\ \vdots\\ z^{[2]}_{64} \end{bmatrix} \right) = \begin{bmatrix} a^{[2]}_1\\ a^{[2]}_2\\ \vdots\\ a^{[2]}_{64} \end{bmatrix} \]&lt;/font&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="230" width="410" x="-350" y="600" as="geometry" />
        </mxCell>
        <mxCell id="DzZVFQiHHRxu_J_QxA1l-190" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;div style=&quot;font-size: 14px; font-style: normal; font-weight: 400; line-height: 20px;&quot;&gt;&lt;div style=&quot;white-space: normal; line-height: 20px;&quot;&gt;&lt;font face=&quot;Mathjax&quot;&gt;Hidden Layer 2 : \(a^{[2]} \to z^{[3]}\) \[ \underbrace{ \begin{bmatrix} w^{[3]}_{11}&amp;amp;w^{[3]}_{12}&amp;amp;\cdots&amp;amp;w^{[3]}_{1,64}\\ w^{[3]}_{21}&amp;amp;w^{[3]}_{22}&amp;amp;\cdots&amp;amp;w^{[3]}_{2,64}\\ \vdots&amp;amp;\vdots&amp;amp;\ddots&amp;amp;\vdots\\ w^{[3]}_{10,1}&amp;amp;w^{[3]}_{10,2}&amp;amp;\cdots&amp;amp;w^{[3]}_{10,64} \end{bmatrix} }_{W^{[3]}} \begin{bmatrix} a^{[2]}_1\\ a^{[2]}_2\\ \vdots\\ a^{[2]}_{64} \end{bmatrix} + \underbrace{ \begin{bmatrix} b^{[3]}_1\\ b^{[3]}_2\\ \vdots\\ b^{[3]}_{10} \end{bmatrix} }_{b^{[3]}} = \begin{bmatrix} z^{[3]}_1\\ z^{[3]}_2\\ \vdots\\ z^{[3]}_{10} \end{bmatrix} \]&lt;/font&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="230" width="400" x="92" y="602" as="geometry" />
        </mxCell>
        <mxCell id="DzZVFQiHHRxu_J_QxA1l-192" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;div style=&quot;font-size: 14px; font-style: normal; font-weight: 400; line-height: 20px;&quot;&gt;&lt;font face=&quot;Mathjax&quot;&gt;Output Layer: \(z^{[3]} \to \hat{\mathbf y}\)&lt;br&gt;&lt;br&gt;\[&lt;br&gt;\operatorname{Softmax}&lt;br&gt;\left(&lt;br&gt;\begin{bmatrix}&lt;br&gt;z^{[3]}_1\\&lt;br&gt;z^{[3]}_2\\&lt;br&gt;\vdots\\&lt;br&gt;z^{[3]}_{10}&lt;br&gt;\end{bmatrix}&lt;br&gt;\right)&lt;br&gt;=&lt;br&gt;\begin{bmatrix}&lt;br&gt;\hat y_1\\&lt;br&gt;\hat y_2\\&lt;br&gt;\vdots\\&lt;br&gt;\hat y_{10}&lt;br&gt;\end{bmatrix}&lt;br&gt;\]&lt;br&gt;&lt;br&gt;\[&lt;br&gt;\hat c&lt;br&gt;=&lt;br&gt;\operatorname*{arg\,max}_i \hat y_i&lt;br&gt;\]&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="300" width="230" x="555" y="600" as="geometry" />
        </mxCell>
        <mxCell id="AyQwnBnqECzVRSljF_cL-3" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;div style=&quot;text-align: justify; font-style: normal; font-weight: 400; line-height: 20px;&quot;&gt;&lt;font face=&quot;Mathjax&quot; style=&quot;font-size: 18px;&quot;&gt;The forward pass is the process of propagating input data through the neural network to generate a prediction. Starting from the input layer, each neuron computes a weighted sum of its inputs, adds a bias term, and applies an activation function such as ReLU. The resulting activations are then passed to the next layer until the output layer is reached. Finally, the Softmax function converts the output values into class probabilities, and the predicted digit is obtained by selecting the class with the highest probability.&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="310" width="360" x="-821" y="90" as="geometry" />
        </mxCell>
